<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 風場預報系統</title>

    <!-- 立即執行主題設定，防止畫面載入閃爍 -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('app_theme');
            if (savedTheme && savedTheme !== 'dark') {
                document.documentElement.setAttribute('data-theme', savedTheme);
            }
        })();
    </script>
    
    <!-- 引用 Bootstrap 5 CSS -->
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"> *@
    <!-- ✅ 修改後：直接引用本機 wwwroot 資料庫 -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <!-- 引用自訂的 CSS 檔案 -->
    <link rel="stylesheet" href="~/css/site.css?v=@DateTime.Now.Ticks" asp-append-version="true" />

    <!-- 新增：背景任務狀態顯示的 CSS 樣式 -->
    <style>
        /* 動畫效果 */
        @@keyframes slow-flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        @@keyframes fast-flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.2; }
        }

        /* 狀態顏色 */
        .status-icon.bg-success { background-color: #198754 !important; } /* Success */
        .status-icon.bg-primary { background-color: #0d6efd !important; } /* Pending */
        .status-icon.bg-warning { background-color: #ffc107 !important; } /* Skipped */
        .status-icon.bg-danger  { background-color: #dc3545 !important; } /* Failed */

        /* 動畫應用 */
        .status-icon.animate-slow-flash {
            animation: slow-flash 2s infinite;
        }
        .status-icon.animate-fast-flash {
            animation: fast-flash 0.7s infinite;
        }
    </style>
</head>
<body> <!-- 讓背景呈現淡淡的灰色，突顯浮動側邊欄 -->

    <div class="d-flex" id="wrapper">
        <!-- 左側浮動圓角側邊欄 (Sidebar) - 移除 shadow-sm，改由 site.css 控制陰影 -->
        <nav id="sidebar-wrapper" class="d-flex flex-column p-3">
            <!-- 1. 頂部 Logo 與標題 -->
            <div class="sidebar-heading d-flex align-items-center mb-3 px-2">
                <img src="/images/ICP_icon.png" alt="ICP Logo" class="sidebar-logo me-2" />
            </div>

            <!-- 2. 團隊/專案切換卡片 -->
            <div class="team-switcher p-2 mb-3 rounded-3 border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <!-- 修改：移除 bg-primary 和 inline-style，並加上 ID 和基礎 class -->
                    <div id="taskStatusIcon" class="status-icon text-white rounded-circle p-1 me-2 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <i class="bi bi-box-fill small"></i>
                    </div>
                    <div>
                        <div class="fw-bold small sidebar_text">FM1</div>
                        <div class="small sidebar_text">Operator team</div>
                    </div>
                </div>
                <i class="bi bi-chevron-expand small"></i>
            </div>

            <!-- 選單群組 -->
            <div class="list-group list-group-flush flex-grow-1">
                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.ForecastDataManager)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/ForecastDataSummary">
                        <i class="bi bi-speedometer2 me-2"></i> Forecast Data
                    </a>
                }
                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.CanaryAPIManager)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/CanaryAPIManager">
                        <i class="bi bi-file-earmark-text me-2"></i> CanaryAPI
                    </a>
                }

                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.TaskManager)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/TaskManagement">
                        <i class="bi bi-chat-dots me-2"></i> Task Management
                    </a>
                }
 
                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.WTGOperator)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/WindTurbineTable">
                        <i class="bi bi-people me-2"></i> Wind Turbine Table
                    </a>
                }

                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.SFTPManager)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/SFTPManagement">
                        <i class="bi bi-check2-square me-2"></i> SFTP Management
                    </a>
                }
                @if (User.HasClaim("Permission", AppPermissions.ViewBrowser.EventLogViewer)){
                    <a class="list-group-item list-group-item-action rounded-2 mb-1 py-2 sidebar_text" href="/api/WindFarm/logViewer">
                        <i class="bi bi-gear me-2"></i> Event Log <span class="badge bg-danger rounded-pill float-end">3</span>
                    </a>
                }


            </div>

            <!-- 底部使用者個人資訊卡片 -->
            <div class="user-profile mt-auto pt-3 border-top d-flex align-items-center justify-content-between px-2">
                <div class="d-flex align-items-center">
                    <img src="/images/icon.ico" alt="User" class="rounded-circle me-2" width="32" height="32" />
                    <div class="text-truncate">
                        <!-- 取得目前登入者的名稱 (若未登入則顯示 Guest) -->
                        <div class="fw-bold small sidebar_text text-truncate" title="@(User.Identity?.Name ?? "Guest")">
                            @(User.Identity?.IsAuthenticated == true ? (User.Identity.Name ?? "User") : "Guest")
                        </div>
                    </div>
                </div>
                <div class="dropdown d-inline-block">
                    <button class="btn-icon-trigger" 
                            type="button" 
                            id="moreMenuButton" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moreMenuButton">
                        @if (User.HasClaim("Permission", AppPermissions.SystemAdmin.SystemAdminOption))
                        {
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="/api/WindFarm/Setting">
                                    <i class="bi bi-sliders"></i> 選項
                                </a>
                            </li>
                        }
                        @if (User.HasClaim("Permission", AppPermissions.SystemAdmin.SystemAdminPermission))
                        {
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="/api/WindFarm/RolePermissionManager">
                                    <i class="bi bi-shield-lock"></i> 權限
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="/Auth/Logout">
                                <i class="bi bi-box-arrow-right"></i> 登出
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- 右側主要內容區 -->
        <div id="page-content-wrapper" class="flex-grow-1 p-4">
            <nav class="navbar navbar-expand-lg app-navbar rounded-3 shadow px-4 mb-4">
                <div class="container-fluid">
                    <span class="navbar-brand fw-bold">@ViewData["Title"]</span>
                </div>
            </nav>

            <main role="main" class="main-content-area rounded-3 shadow-sm p-2 min-vh-75"> <!-- Custom class for light background -->
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 引用 Bootstrap 5 JS Bundle -->
   <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // 動態設定 active 狀態
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname;
            const sidebarLinks = document.querySelectorAll("#sidebar-wrapper .list-group-item");

            sidebarLinks.forEach(link => {
                link.classList.remove("active"); // 僅移除 active 類別，讓 CSS 控制顏色
                if (link.getAttribute("href") === currentPath) { // 檢查 href 是否匹配當前路徑
                    link.classList.add("active"); // 添加 active 類別
                }
            });

            // 定期更新背景任務狀態
            updateTaskStatus(); // 頁面載入時先執行一次
            setInterval(updateTaskStatus, 60000); // 每 5 秒更新一次
        });

        async function updateTaskStatus() {
            const iconElement = document.getElementById('taskStatusIcon');
            if (!iconElement) return;

            try {
                const response = await fetch('/api/SystemConfig/backgroundTaskStatus');
                if (!response.ok) {
                    // 如果 API 呼叫失敗，顯示警告狀態
                    setStatus(iconElement, 'Skipped', 'API Error');
                    return;
                }

                const statuses = await response.json();
                // 假設我們只關心第一個背景任務的狀態
                const taskName = Object.keys(statuses)[0];
                const task = statuses[taskName];

                if (task) {
                    setStatus(iconElement, task.status, task.status);
                } else {
                    // 如果 API 回傳空資料，顯示未知狀態
                    setStatus(iconElement, 'Skipped', 'Unknown');
                }
            } catch (error) {
                console.error('Error fetching task status:', error);
                setStatus(iconElement, 'Skipped', 'Fetch Error');
            }
        }

        function setStatus(element, status, title) {
            // 先移除所有狀態相關的 class
            element.className = element.className.replace(/bg-\w+|animate-\w+-flash/g, '').trim();
            element.title = `Background Task: ${title}`;

            if (status === 'Running') element.classList.add('bg-success', 'animate-slow-flash');
            else if (status === 'Pending') element.classList.add('bg-primary', 'animate-slow-flash');
            else if (status === 'Failed') element.classList.add('bg-danger', 'animate-fast-flash');
            else if (status === 'Success') element.classList.add('bg-success');
            else if (status === 'Skipped') element.classList.add('bg-warning');
            else element.classList.add('bg-secondary'); // 預設/未知狀態
        }
    </script>

    <!-- 全域自訂 JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>