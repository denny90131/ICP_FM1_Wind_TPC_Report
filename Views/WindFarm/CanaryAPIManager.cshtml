@{
    ViewData["Title"] = "Canary API Management Page";
}

<div class="container mb-5">
    <!-- 基礎與 Token 設定卡片 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-gear me-2 text-info"></i>API Basic Settings (Loaded from backend config)</h5>
        
        <hr class="dropdown-divider my-4">

        <h5 class="fw-bold mb-3"><i class="bi bi-key me-2 text-warning"></i>Token Parameter Settings</h5>
        <div class="mb-3">
            <label for="apiToken" class="form-label small fw-bold">API Token (Loaded from backend config):</label>
            <input type="text" class="form-control shadow-none font-mono" id="apiToken" value="@ViewBag.CanaryApiToken">
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Tags (Please name each Tag independently):</label>
            <div id="tagsInputContainer" class="tags-box">
                <!-- 初始 Tag 輸入組合 -->
                <div class="tag-entry">
                    <input type="text" class="form-control shadow-none font-mono tag-value-input" placeholder="Tag Value (e.g., sensor_temp)" value="">
                    <input type="text" class="form-control shadow-none tag-name-input" placeholder="Tag Display Name (e.g., Temperature Sensor)" value="">
                    <button type="button" class="btn btn-outline-danger btn-icon" onclick="removeTagInput(this)" title="Remove this Tag"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="addTagBtn"><i class="bi bi-plus-lg me-1"></i>Add Tag</button>
        </div>

        <div class="mb-3">
            <label for="existingLiveDataToken" class="form-label small fw-bold">Existing Live Data Token (If you have an old Token, fill it here):</label>
            <input type="text" class="form-control shadow-none font-mono" id="existingLiveDataToken" placeholder="Please paste the previously obtained liveDataToken">
        </div>

        <div class="mb-3">
            <label for="mode" class="form-label small fw-bold">Mode (Used when re-initializing):</label>
            <select class="form-select shadow-none font-mono" id="mode">
                <option value="AllValues">AllValues (All changed values)</option>
                <option value="LastValue">LastValue (Only the last record)</option>
            </select>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="button" class="btn btn-primary fw-bold px-4 py-2 shadow-sm" onclick="startLiveDataFlow()">
                <i class="bi bi-arrow-clockwise me-1"></i> 1. Initialize and Get Data
            </button>
            <button type="button" class="btn btn-success fw-bold px-4 py-2 shadow-sm" onclick="useExistingToken()">
                <i class="bi bi-play-fill me-1"></i> 2. Use Existing Token to Fetch Data
            </button>
            <button type="button" class="btn btn-danger fw-bold px-4 py-2 shadow-sm" onclick="revokeToken()">
                <i class="bi bi-x-circle me-1"></i> 3. Revoke/Remove Token
            </button>
        </div>
    </div>

    <!-- Token 狀態顯示區 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Token Status</h5>
        <p id="tokenStatus" class="font-mono mb-0" style="color: var(--text-1);">Not initialized yet</p>
    </div>

    <!-- 已儲存的 Token 設定顯示區 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-bookmark-check me-2 text-primary"></i>Saved Token Settings</h5>
        <div id="savedTokenConfigsList">
            <p class="text-muted font-mono">Currently no saved Token settings.</p>
        </div>
    </div>

    <!-- 即時資料回應顯示區 -->
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-code-square me-2 text-success"></i>Real-time Data Response (Data)</h5>
            <span class="badge badge-outline">JSON Output</span>
        </div>
        <div class="data-readout">
            <pre id="responseOutput">Waiting for data...</pre>
        </div>
    </div>

    <p class="text-muted mt-4 mb-0">This tool is used to test interaction with the real-time data API, please ensure the API base URL is correct.</p>
</div>

@section Scripts {
    <script>
        let currentLiveDataToken = null;
        let currentContinuation = null;
        let updateInterval = null;
        let consecutiveErrors = 0;
        const LOCAL_STORAGE_KEY = 'canaryApiTokens';

        document.addEventListener('DOMContentLoaded', function() {
            renderSavedTokens();
        });

        function useExistingToken() {
            const inputToken = document.getElementById('existingLiveDataToken').value.trim();

            if (!inputToken) {
                alert("Please fill in the Token in the 'Existing Live Data Token' field first!");
                return;
            }

            currentLiveDataToken = inputToken;
            document.getElementById('tokenStatus').innerText = `Using existing Token: ${currentLiveDataToken.substring(0, 8)}...`;

            startPolling();
        }

        function getTagsFromUI() {
            const tagsData = [];
            const tagEntries = document.querySelectorAll('#tagsInputContainer .tag-entry');
            
            for (let entry of tagEntries) {
                const valueInput = entry.querySelector('.tag-value-input');
                const nameInput = entry.querySelector('.tag-name-input');
                const tagValue = valueInput ? valueInput.value.trim() : '';
                const tagName = nameInput ? nameInput.value.trim() : '';

                if (!tagValue || !tagName) {
                    alert("Both 'Tag Value' and 'Tag Display Name' for all Tags cannot be empty!");
                    return null;
                }

                tagsData.push({
                    value: tagValue,
                    displayName: tagName
                });
            }

            if (tagsData.length === 0) {
                alert('Please add at least one Tag!');
                return null;
            }

            return tagsData;
        }
        
        async function startLiveDataFlow() {
            const tagsData = getTagsFromUI();
            const mode = document.getElementById('mode').value;

            if (!tagsData || tagsData.length === 0) {
                return;
            }

            document.getElementById('tokenStatus').innerText = 'Re-initializing to get Token...';
            try {
                const tokenResponse = await fetch('/api/Canary/GetLiveDataToken', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        tags: tagsData,
                        mode: mode
                    })
                });
                
                if (!tokenResponse.ok) {
                    const errorData = await tokenResponse.json();
                    throw new Error(errorData.message || `HTTP Error: ${tokenResponse.status}`);
                }

                const tokenData = await tokenResponse.json();

                if (tokenData.statusCode !== 'Good' || !tokenData.liveDataToken) {
                    const errorDetails = tokenData.details || tokenData.errors || 'Unknown error';
                    throw new Error('Failed to initialize Token: ' + (typeof errorDetails === 'object' ? JSON.stringify(errorDetails) : errorDetails));
                }

                currentLiveDataToken = tokenData.liveDataToken;

                let configName = prompt("Please enter a name for this Token setting (e.g., 'WindFarmA_DailyData'):", `Token_${new Date().toLocaleString()}`);

                if (!configName || configName.trim() === '') {
                    configName = `Unnamed Token_${new Date().toLocaleString()}`;
                }
                
                saveTokenConfig({ name: configName, liveDataToken: tokenData.liveDataToken, tags: tagsData, mode: mode });
                renderSavedTokens();

                document.getElementById('existingLiveDataToken').value = currentLiveDataToken;
                document.getElementById('tokenStatus').innerText = `Successfully obtained new Token: ${currentLiveDataToken.substring(0, 8)}...`;

                if (currentLiveDataToken) startPolling();

            } catch (error) {
                console.error(error);
                document.getElementById('tokenStatus').innerText = `Error occurred: ${error.message}`;
                document.getElementById('responseOutput').innerText = error.message;
            }
        }

        async function revokeToken() {
            const tokenToRevoke = document.getElementById('existingLiveDataToken').value.trim() || currentLiveDataToken;
            if (!tokenToRevoke) {
                alert('Currently no Token to revoke!');
                return;
            }

            if (updateInterval) {
                clearInterval(updateInterval);
                updateInterval = null;
            }

            document.getElementById('tokenStatus').innerText = 'Revoking Token...';

            try {
                const response = await fetch('/api/Canary/RevokeLiveDataToken', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        liveDataToken: tokenToRevoke
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || `HTTP Error: ${response.status}`);
                }

                const result = await response.json();

                if (result.statusCode === 'Good') {
                    document.getElementById('tokenStatus').innerText = 'Token successfully revoked and server resources released';
                    document.getElementById('responseOutput').innerText = JSON.stringify(result, null, 2);
                } else {
                    const errorDetails = result.details || result.errors || 'Unknown error';
                    throw new Error('Revoke failed: ' + (typeof errorDetails === 'object' ? JSON.stringify(errorDetails) : errorDetails));
                }

                if (currentLiveDataToken === tokenToRevoke) {
                    currentLiveDataToken = null;
                    currentContinuation = null;
                    document.getElementById('existingLiveDataToken').value = '';
                }
                deleteSavedToken(tokenToRevoke, true);

            } catch (error) {
                console.error(error);
                document.getElementById('tokenStatus').innerText = `Error occurred during revoke: ${error.message}`;
                document.getElementById('responseOutput').innerText = error.message;
            }
        }

        function saveTokenConfig(config) {
            let configs = loadTokenConfigs();
            const existingIndex = configs.findIndex(c => c.liveDataToken === config.liveDataToken);
            if (existingIndex !== -1) {
                configs[existingIndex] = { ...configs[existingIndex], name: config.name, timestamp: new Date().toISOString() };
            } else {
                configs.push({
                    id: Date.now().toString(),
                    timestamp: new Date().toISOString(),
                    ...config
                });
            }
            localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(configs));
        }

        function loadTokenConfigs() {
            const stored = localStorage.getItem(LOCAL_STORAGE_KEY);
            return stored ? JSON.parse(stored) : [];
        }

        function renderSavedTokens() {
            const savedTokenConfigsList = document.getElementById('savedTokenConfigsList');
            const configs = loadTokenConfigs();
            savedTokenConfigsList.innerHTML = '';

            if (configs.length === 0) {
                savedTokenConfigsList.innerHTML = '<p class="text-muted font-mono">Currently no saved Token settings.</p>';
                return;
            }

            configs.forEach(config => {
                const tokenDisplay = config.liveDataToken ? `${config.liveDataToken.substring(0, 8)}...${config.liveDataToken.slice(-4)}` : 'N/A';
                const configElement = document.createElement('div');
                configElement.className = 'entry-card';
                configElement.innerHTML = `
                    <div class="entry-card-head">
                        <span class="entry-card-name">${config.name}</span>
                        <span class="entry-card-time">${new Date(config.timestamp).toLocaleString()}</span>
                    </div>
                    <div class="entry-row"><span class="k">Token: </span><span class="v">${tokenDisplay}</span></div>`;
                
                if (config.tags && config.tags.length > 0) {
                    configElement.innerHTML += `<div class="entry-row"><span class="k">Tags:</span></div>`;
                    config.tags.forEach(tag => {
                        configElement.innerHTML += `<div class="entry-chip">- ${tag.displayName || tag.value} (<span class="v">${tag.value}</span>)</div>`;
                    });
                } else {
                    configElement.innerHTML += `<div class="entry-row"><span class="k">Tags: </span><span class="text-muted">None</span></div>`;
                }

                configElement.innerHTML += `
                    <div class="entry-row mt-2"><span class="k">Mode: </span><span class="v">${config.mode}</span></div>
                    <div class="entry-actions">
                        <button type="button" class="btn-mini btn-mini-positive" onclick="useSavedToken('${config.id}')">
                            <i class="bi bi-play-fill"></i> Use this Token
                        </button>
                        <button type="button" class="btn-mini btn-mini-danger" onclick="deleteSavedToken('${config.id}')">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                `;
                savedTokenConfigsList.appendChild(configElement);
            });
        }

        function useSavedToken(id) {
            const configs = loadTokenConfigs();
            const configToUse = configs.find(c => c.id === id);

            if (configToUse) {
                if (updateInterval) {
                    clearInterval(updateInterval);
                    updateInterval = null;
                }

                currentLiveDataToken = configToUse.liveDataToken;
                document.getElementById('mode').value = configToUse.mode || 'AllValues';

                document.getElementById('tagsInputContainer').innerHTML = '';
                if (configToUse.tags && configToUse.tags.length > 0) {
                    configToUse.tags.forEach(tag => addTagInput(tag.value, tag.displayName));
                } else {
                    addTagInput();
                }
                document.getElementById('existingLiveDataToken').value = currentLiveDataToken;
                document.getElementById('tokenStatus').innerText = `Loaded and using saved Token: ${configToUse.name}`;
                startPolling();
            } else {
                alert('Specified Token setting not found.');
            }
        }

        function deleteSavedToken(idOrToken, isFromRevoke = false) {
            let configs = loadTokenConfigs();
            const initialLength = configs.length;
            configs = configs.filter(c => c.id !== idOrToken && c.liveDataToken !== idOrToken);
            localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(configs));
            
            if (initialLength > configs.length && !isFromRevoke) {
                alert('Token setting deleted.');
            }
            renderSavedTokens();

            if (currentLiveDataToken === idOrToken || (configs.length < initialLength && currentLiveDataToken === idOrToken)) {
                currentLiveDataToken = null;
                currentContinuation = null;
                document.getElementById('existingLiveDataToken').value = '';
                if (updateInterval) {
                    clearInterval(updateInterval);
                    updateInterval = null;
                }
            }
        }

        function addTagInput(value = '', displayName = '') {
            const tagsInputContainer = document.getElementById('tagsInputContainer');
            const newTagEntry = document.createElement('div');
            newTagEntry.className = 'tag-entry';
            newTagEntry.innerHTML = `
                <input type="text" class="form-control shadow-none font-mono tag-value-input" placeholder="Tag Value" value="${value}" title="Tag 的實際值">
                <input type="text" class="form-control shadow-none tag-name-input" placeholder="Tag Display Name" value="${displayName}" title="Tag 的顯示名稱">
                <button type="button" class="btn btn-outline-danger btn-icon remove-tag-btn" onclick="removeTagInput(this)" title="Remove this Tag"><i class="bi bi-x-lg"></i></button>
            `;
            tagsInputContainer.appendChild(newTagEntry);
        }

        function removeTagInput(buttonElement) {
            const tagEntry = buttonElement.closest('.tag-entry');
            if (tagEntry) {
                tagEntry.remove();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (document.querySelectorAll('#tagsInputContainer .tag-entry').length === 0) {
                addTagInput();
            }
            document.getElementById('addTagBtn').addEventListener('click', () => addTagInput());
        });
        
        function startPolling() {
            if (updateInterval) clearInterval(updateInterval);
            consecutiveErrors = 0;

            fetchLiveData();
            updateInterval = setInterval(fetchLiveData, 2000);
        }

        async function fetchLiveData() {
            if (!currentLiveDataToken) return;

            try {
                const dataResponse = await fetch('/api/Canary/GetLiveData', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        liveDataToken: currentLiveDataToken,
                        continuation: currentContinuation
                    })
                });

                if (!dataResponse.ok) {
                    const errorData = await dataResponse.json().catch(() => null);
                    const errorMessage = errorData?.details || errorData?.message || `HTTP Error ${dataResponse.status}. Token may have expired, please try re-initializing.`;
                    throw new Error(errorMessage);
                }

                consecutiveErrors = 0;

                const result = await dataResponse.json();
                document.getElementById('responseOutput').innerText = JSON.stringify(result, null, 2);
                
                if (result.continuation) {
                    currentContinuation = result.continuation;
                } else {
                    currentContinuation = null;
                }
            } catch (err) {
                console.error("Failed to fetch data:", err);
                document.getElementById('responseOutput').innerText = err.message;
                consecutiveErrors++;
                document.getElementById('tokenStatus').innerText = `Failed to fetch data, consecutive errors: ${consecutiveErrors} times.`;

                if (consecutiveErrors >= 3) {
                    if (updateInterval) {
                        clearInterval(updateInterval);
                        updateInterval = null;
                    }
                    document.getElementById('tokenStatus').innerText = 'Failed to fetch data 3 consecutive times, auto-update stopped. Please check Token or network connection.';
                }
            }
        }
    </script>
}
