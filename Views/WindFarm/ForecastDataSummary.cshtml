@{
    ViewData["Title"] = "Wind Farm Forecast Data Management";
    var now = DateTime.Now;
    var totalMinutes = now.Hour * 60 + now.Minute;
    var roundedTotalMinutes = (int)Math.Round((double)totalMinutes / 5) * 5;
    var roundedTime = now.Date.AddMinutes(roundedTotalMinutes);
    var defaultDataTime = roundedTime.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container mb-5">
    <form id="forecastForm">
        <!-- 核心參數設定卡片 -->
        <div class="card shadow-sm p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-info"></i>1. Fill in Basic Parameters</h5>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="farmId" class="form-label small fw-bold">Wind Farm ID <span class="text-muted">(farmId)</span></label>
                    <input type="number" class="form-control shadow-none font-mono" id="farmId" value="50000001">
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label small fw-bold">Wind Farm Status <span class="text-muted">(status)</span></label>
                    <select class="form-select shadow-none font-mono" id="status">
                        <option value="0">0: Avail (Normal)</option>
                        <option value="1">1: Out (All units stopped for maintenance)</option>
                        <option value="2">2: Test (All units testing)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="dataTime" class="form-label small fw-bold">Start Date Time <span class="text-muted">(dataTime)</span></label>
                    <input type="datetime-local" class="form-control shadow-none font-mono" id="dataTime" value="@defaultDataTime">
                </div>
            </div>

            <hr class="dropdown-divider my-4">

            <div class="row g-3">
                <div class="col-md-3">
                    <label for="maxPower" class="form-label small fw-bold">Max Power <span class="text-muted">(MW)</span></label>
                    <input type="number" step="0.01" class="form-control shadow-none font-mono" id="maxPower" value="192.39">
                </div>
                <div class="col-md-3">
                    <label for="windSpeed" class="form-label small fw-bold">Average Wind Speed <span class="text-muted">(m/s)</span></label>
                    <input type="number" step="0.01" class="form-control shadow-none font-mono" id="windSpeed" value="18.43">
                </div>
                <div class="col-md-3">
                    <label for="avgPower" class="form-label small fw-bold">Total Power Generation <span class="text-muted">(MW)</span></label>
                    <input type="number" step="0.01" class="form-control shadow-none font-mono" id="avgPower" value="192.39">
                </div>
                <div class="col-md-3">
                    <label for="activeFansCount" class="form-label small fw-bold">Active Fans Count <span class="text-muted">(activeFansCount)</span></label>
                    <input type="number" class="form-control shadow-none font-mono" id="activeFansCount" value="1">
                </div>
            </div>
        </div>

        <!-- 執行動作卡片 -->
        <div class="card shadow-sm p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-play-circle me-2 text-warning"></i>2. Execute Generation and Submission</h5>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary fw-bold px-4 py-2 shadow-sm" onclick="submitSingleData()">
                    <i class="bi bi-send me-1"></i> Submit Single Data
                </button>
                <button type="button" class="btn btn-outline-secondary py-2" onclick="generateBatchData(12)">
                    Next 1 Hour <span class="badge badge-outline ms-1">12 records</span>
                </button>
                <button type="button" class="btn btn-outline-secondary py-2" onclick="generateBatchData(288)">
                    Next 1 Day <span class="badge badge-outline ms-1">288 records</span>
                </button>
                <button type="button" class="btn btn-outline-secondary py-2" onclick="generateBatchData(864)">
                    Next 3 Days <span class="badge badge-outline ms-1">864 records</span>
                </button>
                <button type="button" class="btn btn-outline-secondary py-2" onclick="generateBatchData(2016)">
                    Next 7 Days <span class="badge badge-outline ms-1">2016 records</span>
                </button>
            </div>
        </div>
    </form>

    <!-- 回傳結果顯示區 -->
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-code-square me-2 text-success"></i>API Response and Payload Preview</h5>
            <span class="badge badge-outline">JSON Output</span>
        </div>

        <div class="data-readout">
            <pre id="apiResult">Not executed yet...</pre>
        </div>
    </div>
    <p class="text-muted mt-4 mb-0">Use the settings above to quickly generate and preview the JSON Payload structure of wind farm forecast data.</p>
</div>

@section Scripts {
    <script>
        function getCommonFormData() {
            return {
                farmId: parseInt(document.getElementById('farmId').value),
                status: parseInt(document.getElementById('status').value),
                maxPower: parseFloat(document.getElementById('maxPower').value),
                windSpeed: parseFloat(document.getElementById('windSpeed').value),
                avgPower: parseFloat(document.getElementById('avgPower').value),
                activeFansCount: parseInt(document.getElementById('activeFansCount').value)
            };
        }

        function validateForm() {
            const farmId = document.getElementById('farmId').value;
            const dataTimeInput = document.getElementById('dataTime').value;
            if (!farmId || isNaN(parseInt(farmId))) { alert('Please enter a valid wind farm ID.'); return false; }
            if (!dataTimeInput) { alert('Please enter a valid date time.'); return false; }
            return true;
        }

        function submitSingleData() {
            if (!validateForm()) return;
            const commonData = getCommonFormData();
            const dataTimeInput = document.getElementById('dataTime').value;
            const formattedDataTime = dataTimeInput.replace('T', ' ') + ':00';
            const payload = [{ ...commonData, dataTime: formattedDataTime }];
            sendApiRequest(payload);
        }

        function generateBatchData(totalRecords) {
            if (!validateForm()) return;
            const commonData = getCommonFormData();
            const dataTimeInput = document.getElementById('dataTime').value;
            let startTime = new Date(dataTimeInput);
            
            let payload = [];
            for (let i = 0; i < totalRecords; i++) {
                let currentTime = new Date(startTime.getTime() + i * 5 * 60000);
                let year = currentTime.getFullYear();
                let month = String(currentTime.getMonth() + 1).padStart(2, '0');
                let day = String(currentTime.getDate()).padStart(2, '0');
                let hours = String(currentTime.getHours()).padStart(2, '0');
                let minutes = String(currentTime.getMinutes()).padStart(2, '0');
                let seconds = String(currentTime.getSeconds()).padStart(2, '0');
                let formattedTime = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;

                payload.push({ ...commonData, dataTime: formattedTime });
            }
            sendApiRequest(payload);
        }

        async function sendApiRequest(payload) {
            try {
                const tokenResponse = await fetch('/api/SystemConfig/token');
                if (!tokenResponse.ok) {
                    throw new Error('Failed to get Token settings');
                }
                
                const configData = await tokenResponse.json();
                const currentToken = configData.token;

                if (!currentToken) {
                    throw new Error('Current Token setting is empty');
                }

                const apiRes = await fetch('/api/Extensions/Forecast', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${currentToken}`
                    },
                    body: JSON.stringify(payload)
                });

                const apiResultData = await apiRes.json();

                if (!apiRes.ok) {
                    document.getElementById('apiResult').innerText = JSON.stringify({
                        "status": apiRes.status,
                        "errorResponse": apiResultData
                    }, null, 2);
                    return;
                }

                document.getElementById('apiResult').innerText = JSON.stringify({
                    "note": `Successfully sent ${payload.length} records to API`,
                    "responseFromServer": apiResultData,
                    "usedToken": currentToken,
                    "samplePayload": payload.slice(0, 3)
                }, null, 2);

            } catch (error) {
                document.getElementById('apiResult').innerText = JSON.stringify({
                    "error": error.message,
                    "msg": "Request Failed",
                    "code": 500
                }, null, 2);
            }
        }
    </script>
}
