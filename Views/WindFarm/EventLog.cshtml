@{
    ViewData["Title"] = "Wind Farm Report Event Log";
}

<div class="container mb-5">
    <!-- 篩選器卡片 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-funnel me-2 text-primary"></i>Log Filter</h5>
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label for="logSearchTerm" class="form-label small fw-bold">Keyword Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control shadow-none" id="logSearchTerm" placeholder="Enter keyword...">
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label for="logLevelFilter" class="form-label small fw-bold">Log Level</label>
                <select class="form-select shadow-none" id="logLevelFilter">
                    <option value="">All Levels</option>
                    <option value="INF">Info (INF)</option>
                    <option value="WRN">Warning (WRN)</option>
                    <option value="ERR">Error (ERR)</option>
                    <option value="DBG">Debug (DBG)</option>
                    <option value="FTL">Fatal (FTL)</option>
                    <option value="TRC">Trace (TRC)</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label for="logDateFilter" class="form-label small fw-bold">Specific Date</label>
                <input type="date" class="form-control shadow-none" id="logDateFilter" value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-lg-2 col-md-6">
                <button type="button" class="btn btn-primary w-100 fw-bold shadow-sm py-2" onclick="fetchLogs()">
                    <i class="bi bi-arrow-repeat me-1"></i> Filter Logs
                </button>
            </div>
        </div>
    </div>

    <!-- 日誌內容輸出卡片 -->
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-terminal me-2 text-success"></i>Log Content Output</h5>
            <span class="badge badge-outline" id="logStatusBadge">Ready</span>
        </div>

        <div class="data-readout">
            <pre id="logContent" style="min-height: 350px; max-height: 550px;">Loading...</pre>
        </div>
    </div>

    <p class="text-muted mt-4 mb-0">View application logs in real-time, filter precisely by keyword, log level, and date.</p>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            fetchLogs();
        });

        async function fetchLogs() {
            const searchTerm = document.getElementById('logSearchTerm').value;
            const logLevel = document.getElementById('logLevelFilter').value;
            const logDate = document.getElementById('logDateFilter').value;

            let url = `/api/SystemConfig/GetLogs?`;
            if (searchTerm) url += `searchTerm=${encodeURIComponent(searchTerm)}&`;
            if (logLevel) url += `logLevel=${encodeURIComponent(logLevel)}&`;
            if (logDate) url += `date=${encodeURIComponent(logDate)}&`;

            if (url.endsWith('&')) {
                url = url.slice(0, -1);
            }

            const logContentElement = document.getElementById('logContent');
            const statusBadge = document.getElementById('logStatusBadge');
            
            logContentElement.innerText = 'Loading...';
            statusBadge.className = 'badge bg-warning text-dark font-monospace';
            statusBadge.innerText = 'Loading...';

            try {
                const response = await fetch(url);
                if (!response.ok) {
                    const errorText = await response.text();
                    logContentElement.innerText = `Error: ${response.status} - ${errorText}`;
                    statusBadge.className = 'badge bg-danger font-monospace';
                    statusBadge.innerText = 'Error';
                    return;
                }
                const logs = await response.json();
                if (logs.length === 0) {
                    logContentElement.innerText = 'No logs found matching the criteria.';
                    statusBadge.className = 'badge bg-info text-dark font-monospace';
                    statusBadge.innerText = '0 Results';
                } else {
                    logContentElement.innerText = logs.join('\n');
                    statusBadge.className = 'badge bg-success font-monospace';
                    statusBadge.innerText = `${logs.length} entries`;
                }
            } catch (error) {
                logContentElement.innerText = `Failed to load logs: ${error.message}`;
                statusBadge.className = 'badge bg-danger font-monospace';
                statusBadge.innerText = 'Failed';
                console.error('Error fetching logs:', error);
            }
        }
    </script>
}
