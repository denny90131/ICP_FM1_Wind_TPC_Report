@{
    ViewData["Title"] = "Wind Farm Report System Parameter Settings";
}

<div class="container mb-5">    
    <!-- API 服務設定卡片 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up me-2 text-primary"></i>1. API Service Settings</h5>
        <form id="apiSettingsForm">
            <div class="mb-3">
                <label for="apiDomain" class="form-label small fw-bold">API Service Domain <span class="text-muted">(conf_API:Domain)</span></label>
                <input type="text" class="form-control shadow-none" id="apiDomain" value="" readonly>
            </div>
            
            <hr class="dropdown-divider my-4">

            <!-- API Token 檢視區塊 -->
            <h5 class="fw-bold mb-3"><i class="bi bi-key me-2 text-warning"></i>API Token Management</h5>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted">The API Token currently used by the system.</span>
                <button type="button" class="btn btn-outline-warning btn-sm" onclick="viewToken()">
                    <i class="bi bi-eye me-1"></i> View Token
                </button>
            </div>
            <div class="data-readout">
                <pre id="apiTokenDisplay">Click 'View Token' button to display...</pre>
            </div>
            
            <hr class="dropdown-divider my-4">

            <!-- 更新 API Token 區塊 -->
            <h5 class="fw-bold mb-3"><i class="bi bi-arrow-clockwise me-2 text-info"></i>Update API Token</h5>
            <div class="input-group mb-3">
                <input type="text" class="form-control shadow-none" id="newTokenInput" placeholder="Enter new API Token...">
                <button class="btn btn-info fw-bold px-4 py-2 shadow-sm" type="button" onclick="updateApiToken()">
                    <i class="bi bi-upload me-1"></i> Update Token
                </button>
            </div>
        </form>
    </div>

    <!-- SFTP 服務設定卡片 -->
    <div class="card shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-server me-2 text-primary"></i>2. SFTP Service Settings</h5>
        </div>
        <form id="sftpSettingsForm">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="sftpHost" class="form-label small fw-bold">SFTP Host <span class="text-muted">(conf_SFTP:Host)</span></label>
                    <input type="text" class="form-control shadow-none" id="sftpHost" value="" readonly>
                </div>
                <div class="col-md-6">
                    <label for="sftpPort" class="form-label small fw-bold">SFTP Port <span class="text-muted">(conf_SFTP:Port)</span></label>
                    <input type="number" class="form-control shadow-none" id="sftpPort" value="" readonly>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="sftpUsername" class="form-label small fw-bold">SFTP Username <span class="text-muted">(conf_SFTP:Username)</span></label>
                    <input type="text" class="form-control shadow-none" id="sftpUsername" value="" readonly>
                </div>
                <div class="col-md-6">
                    <label for="sftpPassword" class="form-label small fw-bold">SFTP Password <span class="text-muted">(conf_SFTP:Password)</span></label>
                    <input type="password" class="form-control shadow-none" id="sftpPassword" value="" readonly>
                </div>
            </div>
            <span id="sftpVerificationResult" class="ms-3 mt-3 text-muted small"></span>
        </form>
    </div>

    <!-- 外觀主題設定卡片 -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-palette-fill me-2 text-warning"></i>Appearance Theme Settings</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label for="themeSelect" class="form-label small fw-bold">Interface Color Style</label>
                <select id="themeSelect" class="form-select shadow-none" onchange="changeAppTheme(this.value)">
                    <option value="dark">🌙 Dark Mode (Default)</option>
                    <option value="light">☀️ Light Mode</option>
                </select>
                <span class="small text-muted d-block mt-2">After switching, the system will automatically apply the color and save it to the browser.</span>
            </div>
        </div>
    </div>

    <p class="text-muted mt-4 mb-0">Please note that the API Token should be kept safe to avoid leakage.</p>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadApiSettings();
            loadSftpSettings();
            initThemeSelect();
        });

        function initThemeSelect() {
            const savedTheme = localStorage.getItem('app_theme') || 'dark';
            const themeSelect = document.getElementById('themeSelect');
            if (themeSelect) {
                themeSelect.value = savedTheme;
            }
        }

        function changeAppTheme(themeName) {
            if (themeName === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
            localStorage.setItem('app_theme', themeName);
        }

        async function loadApiSettings() {
            try {
                const response = await fetch('/api/SystemConfig/apiSettings');
                if (!response.ok) {
                    console.error('Failed to load API settings:', response.status, await response.text());
                    document.getElementById('apiDomain').value = 'Load failed';
                    return;
                }
                const data = await response.json();
                document.getElementById('apiDomain').value = data.apiDomain || '';
            } catch (error) {
                console.error('Error fetching API settings:', error);
                document.getElementById('apiDomain').value = 'Load error';
            }
        }

        async function loadSftpSettings() {
            try {
                const response = await fetch('/api/SystemConfig/sftpSettings');
                if (!response.ok) {
                    console.error('Failed to load SFTP settings:', response.status, await response.text());
                    document.getElementById('sftpHost').value = 'Load failed';
                    document.getElementById('sftpPort').value = '';
                    document.getElementById('sftpUsername').value = 'Load failed';
                    document.getElementById('sftpPassword').value = 'Load failed';
                    return;
                }
                const data = await response.json();
                document.getElementById('sftpHost').value = data.sftpHost || '';
                document.getElementById('sftpPort').value = data.sftpPort !== undefined ? data.sftpPort : '';
                document.getElementById('sftpUsername').value = data.sftpUsername || '';
                document.getElementById('sftpPassword').value = data.sftpPassword || '';
            } catch (error) {
                console.error('Error fetching SFTP settings:', error);
                document.getElementById('sftpHost').value = 'Load error';
                document.getElementById('sftpPort').value = '';
                document.getElementById('sftpUsername').value = 'Load error';
                document.getElementById('sftpPassword').value = 'Load error';
            }
        }

        async function viewToken() {
            const tokenDisplay = document.getElementById('apiTokenDisplay');
            tokenDisplay.innerText = 'Loading...';

            try {
                const response = await fetch('/api/SystemConfig/token');
                if (!response.ok) {
                    const errorText = await response.text();
                    tokenDisplay.innerText = `Error: ${response.status} - ${errorText}`;
                    alert(`Failed to view Token: ${response.status} - ${errorText}`);
                    return;
                }
                const data = await response.json();
                const fullToken = data.token;
                if (fullToken && typeof fullToken === 'string') {
                    if (fullToken.length > 5) {
                        const numX = fullToken.length - 5;
                        const maskedPart = 'x'.repeat(numX);
                        tokenDisplay.innerText = maskedPart + fullToken.slice(-5);
                    } else {
                        tokenDisplay.innerText = fullToken;
                    }
                } else {
                    tokenDisplay.innerText = 'No Token data.';
                }
            } catch (error) {
                tokenDisplay.innerText = `Failed to load Token: ${error.message}`;
                alert(`Failed to view Token: ${error.message}`);
                console.error('Error fetching token:', error);
            }
        }

        async function updateApiToken() {
            const newTokenInput = document.getElementById('newTokenInput');
            const newToken = newTokenInput.value.trim();

            if (!newToken) {
                alert('Please enter the API Token to update.');
                return;
            }

            try {
                const response = await fetch('/api/SystemConfig/token', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ token: newToken })
                });

                const result = await response.json();
                alert(result.msg || 'Token updated successfully!');
                if (response.ok) {
                    viewToken();
                }
            } catch (error) {
                alert(`Failed to update Token: ${error.message}`);
                console.error('Error updating token:', error);
            }
        }
    </script>
}
