@{
    ViewData["Title"] = "Wind Turbine Information Overview";
}
<div style="height: calc(100vh - 180px); overflow: hidden;">
    <div class="row g-3 h-100">
        <!-- 左側：操作面板 -->
        <div class="col-lg-3 h-100" style="min-height: 0;">
            <div class="card shadow-sm p-4 h-100 d-flex flex-column" style="min-height: 0; overflow: hidden;">
                <h5 class="fw-bold mb-3 flex-shrink-0"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Control Panel</h5>

                <!-- 子系統選擇 -->
                <div class="mb-3 flex-shrink-0">
                    <label for="moduleSelector" class="form-label small fw-bold">1. Select Subsystem</label>
                    <select id="moduleSelector" class="form-select shadow-none">
                        <option selected>Loading...</option>
                    </select>
                </div>

                <!-- 檔案選擇 -->
                <div class="mb-3 flex-grow-1 d-flex flex-column" style="min-height: 0;">
                    <div class="d-flex justify-content-between align-items-center flex-shrink-0">
                        <label for="fileSelector" class="form-label small fw-bold mb-1">2. Select File</label>
                    </div>
                    <!-- 路徑導覽列 -->
                    <div id="pathNavigator" class="entry-card mb-1 p-2 rounded-2 small flex-shrink-0 font-mono" style="min-height: 28px;"></div>
                    <!-- 檔案/資料夾列表 -->
                    <div id="fileListContainer" class="list-group flex-grow-1 data-readout" style="overflow-y: auto; min-height: 0;">
                        <div class="list-group-item text-muted border-0 bg-transparent">Please select a subsystem first</div>
                    </div>
                </div>
                <small class="text-muted text-center mt-2 flex-shrink-0 font-mono">Double-click a file to read data directly</small>
            </div>
        </div>

        <!-- 右側：資料預覽區 -->
        <div class="col-lg-9 h-100" style="min-height: 0;">
            <div class="card shadow-sm p-4 h-100 d-flex flex-column" style="min-height: 0; overflow: hidden;">
                <!-- 頂部：標題、結果訊息與搜尋篩選框 -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3 flex-shrink-0">
                    <h5 class="fw-bold mb-0 flex-shrink-0"><i class="bi bi-table me-2 text-success"></i>Data Preview</h5>

                    <!-- 執行結果訊息 -->
                    <div id="resultMessage" class="entry-card p-2 px-3 rounded-3 flex-grow-1 font-mono" style="display: none;">
                        <span class="text-muted">Waiting for execution...</span>
                    </div>

                    <!-- 資料篩選框 (預設隱藏，載入資料後顯示) -->
                    <div id="filterContainer" class="ms-auto flex-shrink-0" style="display: none; min-width: 240px;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="tableFilterInput" class="form-control border-start-0 shadow-none font-mono" placeholder="Search table content..." />
                            <button class="btn btn-outline-secondary" type="button" id="clearFilterBtn" title="Clear search">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 資料表格 -->
                <div id="dataTableContainer" class="table-responsive flex-grow-1 font-mono" style="overflow-y: auto; min-height: 0;">
                    <p class="text-muted">After execution, results will be displayed here.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    /* 檔案選單項目樣式適配主題 */
    #fileListContainer .list-group-item {
        color: var(--text-1);
        background-color: transparent;
        border: none;
        border-radius: var(--radius-sm);
        margin: 2px 4px;
        padding: 0.45rem 0.75rem;
        cursor: pointer;
        font-size: 0.85rem;
        line-height: 1.4;
        display: flex;
        align-items: center;
        white-space: nowrap;
        flex-shrink: 0;
        font-family: inherit;
        transition: all 0.15s ease;
    }
    #fileListContainer .list-group-item:hover {
        background-color: var(--sidebar-hover-bg, var(--sidebar-hover-bg-fallback));
        color: var(--accent-cyan);
    }
    #fileListContainer .list-group-item.active {
        background-color: var(--sidebar-active-bg, var(--sidebar-active-bg-fallback));
        color: var(--accent-cyan);
        font-weight: 600;
        border-left: 3px solid var(--sidebar-accent-color, var(--sidebar-accent-color-fallback));
    }

    /* 預覽表格樣式適配主題 */
    .table-theme-custom {
        color: var(--text-1);
        border-color: var(--hairline);
        vertical-align: middle;
        font-size: 0.85rem;
    }
    .table-theme-custom thead th {
        background-color: var(--bg-panel-raised);
        color: var(--text-2);
        border-color: var(--hairline);
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 0.65rem 0.75rem;
    }
    .table-theme-custom tbody td {
        background-color: transparent;
        color: var(--text-1);
        border-color: var(--hairline-soft);
        padding: 0.6rem 0.75rem;
    }
    .table-theme-custom tbody tr:hover td {
        background-color: var(--sidebar-hover-bg, var(--sidebar-hover-bg-fallback));
    }

    /* 搜尋框整體樣式適配主題 */
    #filterContainer .input-group-text,
    #filterContainer input,
    #filterContainer #clearFilterBtn {
        border-color: var(--hairline, #dee2e6);
        color: var(--text-1);
        background-color: var(--bg-panel-raised, transparent);
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    /* 移除 input 預設各自為政的 focus 陰影與邊框變色 */
    #filterContainer input:focus {
        box-shadow: none;
    }

    /* 當 group 內的任何元件（input）處於 focus 狀態時，全體周圍邊框一起變色 */
    #filterContainer .input-group:focus-within .input-group-text,
    #filterContainer .input-group:focus-within input,
    #filterContainer .input-group:focus-within #clearFilterBtn {
        border-color: var(--accent-cyan, #0d6efd);
    }

    /* （可選）為整組輸入框加上一體化的外發光/陰影效果 */
    #filterContainer .input-group:focus-within {
        border-radius: var(--bs-border-radius-sm, 0.25rem);
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15); /* 若有 --accent-cyan-rgb 變數亦可替換 */
    }
</style>

<script>
    // 全域變數：暫存當前開啟檔案的完整資料
    let currentRawData = [];

    document.addEventListener('DOMContentLoaded', function() {
        const moduleSelector = document.getElementById('moduleSelector');
        const filterInput = document.getElementById('tableFilterInput');
        const clearBtn = document.getElementById('clearFilterBtn');
        
        fetchModules();
        
        moduleSelector.addEventListener('change', function() {
            const selectedModuleId = this.value;
            if (selectedModuleId) {
                fetchFiles(selectedModuleId);
            } else {
                resetFileSelector();
            }
        });

        // 監聽篩選輸入（即時比對）
        filterInput.addEventListener('input', function() {
            applyDataFilter(this.value);
        });

        // 清除搜尋按鈕
        clearBtn.addEventListener('click', function() {
            filterInput.value = '';
            applyDataFilter('');
            filterInput.focus();
        });
    });

    async function fetchModules() {
        const moduleSelector = document.getElementById('moduleSelector');
        try {
            const response = await fetch('/api/excelreader/modules');
            if (!response.ok) throw new Error('Failed to get subsystem list');
            
            const modules = await response.json();
            moduleSelector.innerHTML = '<option value="" selected>-- Please select a subsystem --</option>';
            
            modules.forEach(module => {
                const option = new Option(`${module.moduleName} (${module.moduleId})`, module.moduleId);
                moduleSelector.add(option);
            });
        } catch (error) {
            moduleSelector.innerHTML = `<option selected>Error: ${error.message}</option>`;
            console.error(error);
        }
    }

    async function fetchFiles(moduleId, path = '') {
        const fileListContainer = document.getElementById('fileListContainer');
        fileListContainer.innerHTML = '<div class="list-group-item text-muted border-0 bg-transparent">Loading files...</div>';

        try {
            const response = await fetch(`/api/excelreader/files/${moduleId}?path=${encodeURIComponent(path)}`);
            if (!response.ok) throw new Error('Failed to get file list');

            const result = await response.json();
            const items = result.items;
            updatePathNavigator(moduleId, result.currentPath);

            fileListContainer.innerHTML = '';

            if (items.length > 0) {
                items.forEach(item => {
                    const fileItem = document.createElement('a');
                    fileItem.href = '#';
                    fileItem.className = 'list-group-item list-group-item-action text-truncate';

                    if (item.isDirectory) {
                        fileItem.innerHTML = `<i class="bi bi-folder-fill text-warning me-2"></i><strong>${item.name}</strong>`;
                        fileItem.onclick = (e) => {
                            e.preventDefault();
                            fetchFiles(moduleId, item.path);
                        };
                    } else {
                        fileItem.innerHTML = `<i class="bi bi-file-earmark-text text-info me-2"></i>${item.name}`;
                        fileItem.dataset.filePath = item.path;
                        
                        fileItem.onclick = function (e) {
                            e.preventDefault();
                            document.querySelectorAll('#fileListContainer .list-group-item').forEach(el => el.classList.remove('active'));
                            this.classList.add('active');
                        };

                        fileItem.ondblclick = function (e) {
                            e.preventDefault();
                            processFile(this.dataset.filePath);
                        };
                    }
                    fileListContainer.appendChild(fileItem);
                });
            } else {
                fileListContainer.innerHTML = '<div class="list-group-item text-muted border-0 bg-transparent">This directory is empty</div>';
            }
        } catch (error) {
            fileListContainer.innerHTML = `<div class="list-group-item text-danger border-0 bg-transparent">${error.message}</div>`;
            console.error(error);
        }
    }

    function updatePathNavigator(moduleId, currentPath) {
        const pathNavigator = document.getElementById('pathNavigator');
        let html = '';

        if (currentPath && currentPath !== '/' && currentPath !== '') {
            let parentPath = '';
            if (currentPath.includes('/')) {
                parentPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
            } else {
                parentPath = '';
            }

            html += `<a href="#" onclick="event.preventDefault(); fetchFiles('${moduleId}', '${parentPath.replace(/'/g, "\\'")}')" class="text-decoration-none me-2">
                        <i class="bi bi-arrow-left-circle"></i> Back
                    </a> | `;
        }

        const displayPath = (!currentPath || currentPath === '') ? '/' : currentPath;
        html += `<span>Path: </span><strong style="color: var(--accent-cyan);">${displayPath}</strong>`;
        pathNavigator.innerHTML = html;
    }
    
    async function processFile(filePath) {
        const moduleId = document.getElementById('moduleSelector').value;
        const resultMessage = document.getElementById('resultMessage');
        const tableContainer = document.getElementById('dataTableContainer');
        const filterContainer = document.getElementById('filterContainer');
        const filterInput = document.getElementById('tableFilterInput');

        if (!moduleId || !filePath) {
            alert('Please select a subsystem and file first!');
            return;
        }

        resultMessage.style.display = 'block';
        resultMessage.innerHTML = '<span class="text-info">Processing, please wait...</span>';
        tableContainer.innerHTML = '<p class="text-info">Waiting for backend response...</p>';
        filterContainer.style.display = 'none';
        filterInput.value = '';

        try {
            const response = await fetch('/api/excelreader/execute-by-file', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ModuleId: moduleId, FilePath: filePath })
            });

            const result = await response.json();
            const messageClass = result.isSuccess ? 'text-success' : 'text-danger';
            resultMessage.innerHTML = `<span class="${messageClass}">${result.message}</span>`;

            if (result.isSuccess && result.data && result.data.length > 0) {
                currentRawData = result.data; // 快取原始資料供篩選
                filterContainer.style.display = 'block';
                renderTable(currentRawData);
            } else {
                currentRawData = [];
                tableContainer.innerHTML = '<p class="text-muted">Returned data is empty.</p>';
            }

        } catch (error) {
            currentRawData = [];
            resultMessage.innerHTML = `<span class="text-danger">Request failed: ${error.message}</span>`;
            tableContainer.innerHTML = `<p class="text-danger">Failed to load data: ${error.message}</p>`;
            console.error(error);
        }
    }

    // 依關鍵字過濾資料
    function applyDataFilter(keyword) {
        if (!currentRawData || currentRawData.length === 0) return;

        const term = keyword.trim().toLowerCase();
        if (!term) {
            renderTable(currentRawData);
            return;
        }

        const filtered = currentRawData.filter(row => {
            return Object.values(row).some(val => 
                val !== null && val !== undefined && String(val).toLowerCase().includes(term)
            );
        });

        renderTable(filtered, true);
    }
    
    function renderTable(data, isFiltered = false) {
        const tableContainer = document.getElementById('dataTableContainer');
        if (!data || data.length === 0) {
            tableContainer.innerHTML = isFiltered 
                ? '<p class="text-muted"><i class="bi bi-search me-1"></i>No data matches the filter criteria.</p>'
                : '<p class="text-muted">Returned data is empty.</p>';
            return;
        }

        // 以原始資料的 keys 為基準（避免篩選後的物件有缺欄位）
        const headers = Object.keys(currentRawData[0] || data[0]);
        let tableHtml = '<table class="table table-theme-custom table-bordered">';
        
        tableHtml += '<thead><tr>';
        headers.forEach(header => tableHtml += `<th>${header}</th>`);
        tableHtml += '</tr></thead>';

        tableHtml += '<tbody>';
        data.forEach(row => {
            tableHtml += '<tr>';
            headers.forEach(header => tableHtml += `<td>${row[header] !== undefined && row[header] !== null ? row[header] : ''}</td>`);
            tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table>';

        tableContainer.innerHTML = tableHtml;
    }
</script>
}
