@{
    ViewData["Title"] = "各風機信息概覽";
}
<div style="height: calc(100vh - 180px); overflow: hidden;">
    <div class="row g-3 h-100">
        <!-- 左側：操作面板 -->
        <div class="col-lg-3 h-100" style="min-height: 0;">
            <div class="card shadow-sm p-4 h-100 d-flex flex-column" style="min-height: 0; overflow: hidden;">
                <h5 class="fw-bold mb-3 flex-shrink-0"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>操作面板</h5>

                <!-- 子系統選擇 -->
                <div class="mb-3 flex-shrink-0">
                    <label for="moduleSelector" class="form-label small fw-bold">1. 選擇子系統</label>
                    <select id="moduleSelector" class="form-select shadow-none">
                        <option selected>載入中...</option>
                    </select>
                </div>

                <!-- 檔案選擇 -->
                <div class="mb-3 flex-grow-1 d-flex flex-column" style="min-height: 0;">
                    <div class="d-flex justify-content-between align-items-center flex-shrink-0">
                        <label for="fileSelector" class="form-label small fw-bold mb-1">2. 選擇檔案</label>
                    </div>
                    <!-- 路徑導覽列 -->
                    <div id="pathNavigator" class="entry-card mb-1 p-2 rounded-2 small flex-shrink-0 font-mono" style="min-height: 28px;"></div>
                    <!-- 檔案/資料夾列表 -->
                    <div id="fileListContainer" class="list-group flex-grow-1 data-readout" style="overflow-y: auto; min-height: 0;">
                        <div class="list-group-item text-muted border-0 bg-transparent">請先選擇子系統</div>
                    </div>
                </div>
                <small class="text-muted text-center mt-2 flex-shrink-0 font-mono">雙擊檔案即可直接讀取資料</small>
            </div>
        </div>

        <!-- 右側：資料預覽區 -->
        <div class="col-lg-9 h-100" style="min-height: 0;">
            <div class="card shadow-sm p-4 h-100 d-flex flex-column" style="min-height: 0; overflow: hidden;">
                <h5 class="fw-bold mb-3 flex-shrink-0"><i class="bi bi-table me-2 text-success"></i>資料預覽</h5>

                <!-- 執行結果訊息 -->
                <div id="resultMessage" class="entry-card mb-3 p-3 rounded-3 flex-shrink-0 font-mono" style="display: none;">
                    <span class="text-muted">等待執行...</span>
                </div>

                <!-- 資料表格 -->
                <div id="dataTableContainer" class="table-responsive flex-grow-1 font-mono" style="overflow-y: auto; min-height: 0;">
                    <p class="text-muted">執行處理後，結果將會顯示於此。</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    /* 檔案選單項目樣式適配主題 */
    #fileListContainer .list-group-item {
        color: var(--text-1);
        background-color: transparent;
        border: none;
        border-radius: var(--radius-sm);
        margin: 2px 4px;
        padding: 0.45rem 0.75rem;
        cursor: pointer;
        font-size: 0.85rem;
        line-height: 1.4;              /* 1. 明確指定正常行高，防止字體被垂直擠壓 */
        display: flex;                  /* 2. 改為彈性盒子排版 */
        align-items: center;            /* 3. 圖示與文字垂直居中對齊 */
        white-space: nowrap;            /* 4. 單行不換行 */
        flex-shrink: 0;                 /* 5. 防止 flex 容器把每一列壓扁 */
        font-family: inherit;           /* 6. 若被 font-mono 破壞，強制使用預設字體 */
        transition: all 0.15s ease;
    }
    #fileListContainer .list-group-item:hover {
        background-color: var(--sidebar-hover-bg, var(--sidebar-hover-bg-fallback));
        color: var(--accent-cyan);
    }
    #fileListContainer .list-group-item.active {
        background-color: var(--sidebar-active-bg, var(--sidebar-active-bg-fallback));
        color: var(--accent-cyan);
        font-weight: 600;
        border-left: 3px solid var(--sidebar-accent-color, var(--sidebar-accent-color-fallback));
    }

    /* 預覽表格樣式適配主題 */
    .table-theme-custom {
        color: var(--text-1);
        border-color: var(--hairline);
        vertical-align: middle;
        font-size: 0.85rem;
    }
    .table-theme-custom thead th {
        background-color: var(--bg-panel-raised);
        color: var(--text-2);
        border-color: var(--hairline);
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 0.65rem 0.75rem;
    }
    .table-theme-custom tbody td {
        background-color: transparent;
        color: var(--text-1);
        border-color: var(--hairline-soft);
        padding: 0.6rem 0.75rem;
    }
    .table-theme-custom tbody tr:hover td {
        background-color: var(--sidebar-hover-bg, var(--sidebar-hover-bg-fallback));
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const moduleSelector = document.getElementById('moduleSelector');
        
        fetchModules();

        moduleSelector.addEventListener('change', function() {
            const selectedModuleId = this.value;
            if (selectedModuleId) {
                fetchFiles(selectedModuleId);
            } else {
                resetFileSelector();
            }
        });
    });

    async function fetchModules() {
        const moduleSelector = document.getElementById('moduleSelector');
        try {
            const response = await fetch('/api/excelreader/modules');
            if (!response.ok) throw new Error('無法獲取子系統列表');
            
            const modules = await response.json();
            moduleSelector.innerHTML = '<option value="" selected>-- 請選擇一個子系統 --</option>';
            
            modules.forEach(module => {
                const option = new Option(`${module.moduleName} (${module.moduleId})`, module.moduleId);
                moduleSelector.add(option);
            });
        } catch (error) {
            moduleSelector.innerHTML = `<option selected>錯誤: ${error.message}</option>`;
            console.error(error);
        }
    }

    async function fetchFiles(moduleId, path = '') {
        const fileListContainer = document.getElementById('fileListContainer');
        fileListContainer.innerHTML = '<div class="list-group-item text-muted border-0 bg-transparent">載入檔案中...</div>';

        try {
            const response = await fetch(`/api/excelreader/files/${moduleId}?path=${encodeURIComponent(path)}`);
            if (!response.ok) throw new Error('無法獲取檔案列表');

            const result = await response.json();
            const items = result.items;
            updatePathNavigator(moduleId, result.currentPath);

            fileListContainer.innerHTML = '';

            if (items.length > 0) {
                items.forEach(item => {
                    const fileItem = document.createElement('a');
                    fileItem.href = '#';
                    fileItem.className = 'list-group-item list-group-item-action text-truncate';

                    if (item.isDirectory) {
                        fileItem.innerHTML = `<i class="bi bi-folder-fill text-warning me-2"></i><strong>${item.name}</strong>`;
                        fileItem.onclick = (e) => {
                            e.preventDefault();
                            fetchFiles(moduleId, item.path);
                        };
                    } else {
                        fileItem.innerHTML = `<i class="bi bi-file-earmark-text text-info me-2"></i>${item.name}`;
                        fileItem.dataset.filePath = item.path;
                        
                        fileItem.onclick = function (e) {
                            e.preventDefault();
                            document.querySelectorAll('#fileListContainer .list-group-item').forEach(el => el.classList.remove('active'));
                            this.classList.add('active');
                        };

                        fileItem.ondblclick = function (e) {
                            e.preventDefault();
                            processFile(this.dataset.filePath);
                        };
                    }
                    fileListContainer.appendChild(fileItem);
                });
            } else {
                fileListContainer.innerHTML = '<div class="list-group-item text-muted border-0 bg-transparent">此目錄是空的</div>';
            }
        } catch (error) {
            fileListContainer.innerHTML = `<div class="list-group-item text-danger border-0 bg-transparent">${error.message}</div>`;
            console.error(error);
        }
    }

    function updatePathNavigator(moduleId, currentPath) {
        const pathNavigator = document.getElementById('pathNavigator');
        let html = '';

        if (currentPath && currentPath !== '/') {
            let parentPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
            if (parentPath === '') parentPath = '/';

            html += `<a href="#" onclick="event.preventDefault(); fetchFiles('${moduleId}', '${parentPath.replace(/'/g, "\\'")}')" class="text-decoration-none me-2">
                        <i class="bi bi-arrow-left-circle"></i> 返回
                     </a> | `;
        }

        html += `<span>路徑: </span><strong style="color: var(--accent-cyan);">${currentPath}</strong>`;
        pathNavigator.innerHTML = html;
    }

    function resetFileSelector() {
        const fileListContainer = document.getElementById('fileListContainer');
        document.getElementById('pathNavigator').innerHTML = '';
        fileListContainer.innerHTML = '<div class="list-group-item text-muted border-0 bg-transparent">請先選擇子系統</div>';
    }

    async function processFile(filePath) {
        const moduleId = document.getElementById('moduleSelector').value;
        const resultMessage = document.getElementById('resultMessage');
        const tableContainer = document.getElementById('dataTableContainer');

        if (!moduleId || !filePath) {
            alert('請先選擇子系統和檔案！');
            return;
        }

        resultMessage.style.display = 'block';
        resultMessage.innerHTML = '<span class="text-info">處理中，請稍候...</span>';
        tableContainer.innerHTML = '<p class="text-info">正在等待後端回傳資料...</p>';

        try {
            const response = await fetch('/api/excelreader/execute-by-file', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ModuleId: moduleId, FilePath: filePath })
            });

            const result = await response.json();
            const messageClass = result.isSuccess ? 'text-success' : 'text-danger';
            resultMessage.innerHTML = `<span class="${messageClass}">${result.message}</span>`;

            if (result.isSuccess && result.data && result.data.length > 0) {
                renderTable(result.data);
            } else {
                tableContainer.innerHTML = '<p class="text-muted">無資料可供顯示。</p>';
            }

        } catch (error) {
            resultMessage.innerHTML = `<span class="text-danger">請求失敗: ${error.message}</span>`;
            tableContainer.innerHTML = `<p class="text-danger">無法載入資料: ${error.message}</p>`;
            console.error(error);
        }
    }

    function renderTable(data) {
        const tableContainer = document.getElementById('dataTableContainer');
        if (!data || data.length === 0) {
            tableContainer.innerHTML = '<p class="text-muted">回傳資料為空。</p>';
            return;
        }

        const headers = Object.keys(data[0]);
        let tableHtml = '<table class="table table-theme-custom table-bordered">';
        
        tableHtml += '<thead><tr>';
        headers.forEach(header => tableHtml += `<th>${header}</th>`);
        tableHtml += '</tr></thead>';

        tableHtml += '<tbody>';
        data.forEach(row => {
            tableHtml += '<tr>';
            headers.forEach(header => tableHtml += `<td>${row[header] || ''}</td>`);
            tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table>';

        tableContainer.innerHTML = tableHtml;
    }
</script>
}