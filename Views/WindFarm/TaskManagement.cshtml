@{
    ViewData["Title"] = "Background Task Management";
}
<div class="container-fluid mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Task Status List</h5>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="fetchTaskStatuses()">
            <i class="bi bi-arrow-clockwise me-1"></i> Manual Refresh
        </button>
    </div>

    <div id="task-status-container" class="row g-4">
        <!-- 狀態卡片將會動態插入到這裡 -->
        <div class="col-12">
            <p class="text-info font-mono">Loading task status...</p>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .status-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left-width: 4px !important;
        border-left-style: solid !important;
    }
    .status-card:hover {
        transform: translateY(-2px);
    }

    .status-card.border-success   { border-left-color: var(--accent-cyan) !important; }
    .status-card.border-primary   { border-left-color: var(--accent-amber) !important; }
    .status-card.border-danger    { border-left-color: var(--accent-red) !important; }
    .status-card.border-warning   { border-left-color: var(--accent-amber) !important; }
    .status-card.border-secondary { border-left-color: var(--hairline) !important; }

    .status-badge {
        font-size: 0.78rem;
        padding: 0.35em 0.65em;
        font-family: var(--font-mono);
    }

    .task-name {
        font-size: 1.05rem;
        color: var(--text-1);
    }

    .error-message {
        font-size: 0.8rem;
        background-color: var(--bg-void);
        border: 1px solid var(--accent-red-dim);
        color: var(--accent-red);
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        white-space: pre-wrap;
        word-break: break-all;
        font-family: var(--font-mono);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetchTaskStatuses();
        setInterval(fetchTaskStatuses, 5000);
    });

    async function fetchTaskStatuses() {
        const container = document.getElementById('task-status-container');

        try {
            const response = await fetch('/api/SystemConfig/backgroundTaskStatus');
            if (!response.ok) {
                throw new Error(`API request failed: ${response.status}`);
            }

            const statuses = await response.json();
            renderTaskCards(statuses);

        } catch (error) {
            console.error('無法獲取任務狀態:', error);
            container.innerHTML = `<div class="col-12"><p class="text-danger font-mono">Failed to load task status: ${error.message}</p></div>`;
        }
    }

    function renderTaskCards(statuses) {
        const container = document.getElementById('task-status-container');
        container.innerHTML = '';

        if (Object.keys(statuses).length === 0) {
            container.innerHTML = `<div class="col-12"><p class="text-muted font-mono">No background tasks are currently being monitored.</p></div>`;
            return;
        }

        for (const taskName in statuses) {
            const task = statuses[taskName];
            const cardHtml = createTaskCard(task);
            container.insertAdjacentHTML('beforeend', cardHtml);
        }
    }

    function createTaskCard(task) {
        const { status, lastExecutionTime, nextScheduledTime, lastErrorMessage } = task;

        let statusClass = 'secondary';
        let statusBadgeClass = 'bg-secondary text-light';
        let statusText = status;

        switch (status.toLowerCase()) {
            case 'success':
                statusClass = 'success';
                statusBadgeClass = 'bg-success text-light';
                statusText = 'Success';
                break;
            case 'running':
                statusClass = 'primary';
                statusBadgeClass = 'bg-primary text-dark';
                statusText = 'Running';
                break;
            case 'failed':
                statusClass = 'danger';
                statusBadgeClass = 'bg-danger text-light';
                statusText = 'Failed';
                break;
            case 'skipped':
                statusClass = 'warning';
                statusBadgeClass = 'bg-warning text-dark';
                statusText = 'Skipped';
                break;
            case 'pending':
                statusClass = 'warning';
                statusBadgeClass = 'bg-warning text-dark';
                statusText = 'Pending';
                break;
        }

        const lastRun = lastExecutionTime ? new Date(lastExecutionTime).toLocaleString() : 'Not executed yet';
        const nextRun = nextScheduledTime ? new Date(nextScheduledTime).toLocaleString() : 'Not scheduled';
        const errorHtml = lastErrorMessage ?
            `<div class="mt-3">
                <strong class="text-danger small">Last error message:</strong>
                <pre class="error-message mt-1">${lastErrorMessage}</pre>
            </div>` : '';

        return `
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm p-3 status-card border-${statusClass}">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-bold mb-0 task-name">${task.taskName}</h6>
                        <span class="badge ${statusBadgeClass} status-badge rounded-pill">${statusText}</span>
                    </div>
                    <hr class="dropdown-divider my-2">
                    <p class="small text-muted mb-1 font-mono"><strong>Last Run:</strong> <span style="color: var(--text-1);">${lastRun}</span></p>
                    <p class="small text-muted mb-0 font-mono"><strong>Next Scheduled:</strong> <span style="color: var(--text-1);">${nextRun}</span></p>
                    ${errorHtml}
                </div>
            </div>
        `;
    }
</script>
}
