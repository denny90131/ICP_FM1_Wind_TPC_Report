@{
    ViewData["Title"] = "背景任務管理";
}
<div class="container-fluid mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-light mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>任務狀態列表</h5>
        <button type="button" class="btn btn-outline-light btn-sm" onclick="fetchTaskStatuses()">
            <i class="bi bi-arrow-clockwise me-1"></i> 手動刷新
        </button>
    </div>

    <div id="task-status-container" class="row g-4">
        <!-- 狀態卡片將會動態插入到這裡 -->
        <div class="col-12">
            <p class="text-info">正在載入任務狀態...</p>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .status-card {
        transition: all 0.3s ease-in-out;
        border-left-width: 5px;
        border-left-style: solid;
    }

    .status-card.border-success { border-color: #198754 !important; }
    .status-card.border-primary { border-color: #0d6efd !important; }
    .status-card.border-danger  { border-color: #dc3545 !important; }
    .status-card.border-warning { border-color: #ffc107 !important; }
    .status-card.border-secondary { border-color: #6c757d !important; }

    .status-badge {
        font-size: 0.9rem;
        padding: 0.5em 0.75em;
    }

    .task-name {
        font-size: 1.2rem;
    }

    .error-message {
        font-size: 0.85rem;
        background-color: #343a40;
        border: 1px solid #495057;
        padding: 10px;
        border-radius: 5px;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetchTaskStatuses(); // 頁面載入時先執行一次
        setInterval(fetchTaskStatuses, 5000); // 每 5 秒更新一次
    });

    async function fetchTaskStatuses() {
        const container = document.getElementById('task-status-container');

        try {
            const response = await fetch('/api/SystemConfig/backgroundTaskStatus');
            if (!response.ok) {
                throw new Error(`API 請求失敗: ${response.status}`);
            }

            const statuses = await response.json();
            renderTaskCards(statuses);

        } catch (error) {
            console.error('無法獲取任務狀態:', error);
            container.innerHTML = `<div class="col-12"><p class="text-danger">無法載入任務狀態: ${error.message}</p></div>`;
        }
    }

    function renderTaskCards(statuses) {
        const container = document.getElementById('task-status-container');
        container.innerHTML = ''; // 清空現有內容

        if (Object.keys(statuses).length === 0) {
            container.innerHTML = `<div class="col-12"><p class="text-muted">目前沒有正在監控的背景任務。</p></div>`;
            return;
        }

        for (const taskName in statuses) {
            const task = statuses[taskName];
            const cardHtml = createTaskCard(task);
            container.insertAdjacentHTML('beforeend', cardHtml);
        }
    }

    function createTaskCard(task) {
        const { status, lastExecutionTime, nextScheduledTime, lastErrorMessage } = task;

        let statusClass = 'secondary';
        let statusText = status;

        switch (status.toLowerCase()) {
            case 'success':
                statusClass = 'success';
                statusText = '成功';
                break;
            case 'running':
                statusClass = 'primary';
                statusText = '執行中';
                break;
            case 'failed':
                statusClass = 'danger';
                statusText = '失敗';
                break;
            case 'skipped':
                statusClass = 'warning';
                statusText = '已跳過';
                break;
            case 'pending':
                statusClass = 'info';
                statusText = '待命中';
                break;
        }

        const lastRun = lastExecutionTime ? new Date(lastExecutionTime).toLocaleString() : '尚未執行';
        const nextRun = nextScheduledTime ? new Date(nextScheduledTime).toLocaleString() : '未排程';
        const errorHtml = lastErrorMessage ?
            `<div class="mt-3">
                <strong class="text-danger small">最後錯誤訊息:</strong>
                <pre class="error-message text-white-50 mt-1">${lastErrorMessage}</pre>
            </div>` : '';

        return `
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 p-3 rounded-4 status-card border-${statusClass}">
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fw-bold text-light mb-0 task-name">${task.taskName}</h6>
                        <span class="badge bg-${statusClass} status-badge">${statusText}</span>
                    </div>
                    <hr class="border-secondary my-2">
                    <p class="small text-muted mb-1"><strong>上次執行:</strong> <span class="text-light">${lastRun}</span></p>
                    <p class="small text-muted mb-0"><strong>下次預計:</strong> <span class="text-light">${nextRun}</span></p>
                    ${errorHtml}
                </div>
            </div>
        `;
    }
</script>
}